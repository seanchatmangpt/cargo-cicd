@prefix clc: <https://ggen.dev/ontology/capability-lineage-consumer#> .

clc:cargo-cicd a clc:Consumer ;
  clc:repository "seanchatmangpt/cargo-cicd" ;
  clc:exactBase "219f0db300fa9b615b6a71f106a4acdd192cf9fc" ;
  clc:sourcePack "capability-lineage-propagation-pack" ;
  clc:authority "SELECT|CONSTRUCT|VERIFY" ;
  clc:actuationAllowed false ;
  clc:agentCommandBoundary "cargo cicd *" ;
  clc:sourceOwnership "canonical-source" ;
  clc:generatedOwnership "projection-only" ;
  clc:receiptRequired true ;
  clc:replayRequired true ;
  clc:qualificationRequired true ;
  clc:ocelRequired true ;
  clc:processIntelligenceOwner "wasm4pm/wasm4pm-compat" .

{
  "cargo-cicd-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --bin cargo-cicd -- cicd hooks pre-tool-use --repo $WORKSPACE_DIR --json",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
{
  "model": "claude-sonnet-4-6",

  "includeCoAuthoredBy": true,

  "context_files": [
    "CLAUDE.md",
    ".claude/ARCHITECTURE.md",
    ".claude/PATTERNS.md",
    "Cargo.toml",
    "cicd.toml"
  ],

  "env": {
    "RUST_BACKTRACE": "1",
    "RUST_LOG": "info",
    "CARGO_TERM_COLOR": "always"
  },

  "permissions": {
    "allow": [
      "Bash(cargo make*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo check*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "Bash(cargo cicd*)",
      "Bash(cargo run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(git show*)",
      "Bash(git tag*)",
      "Bash(wpm audit*)",
      "Bash(wpm receipt*)",
      "Bash(wpm --version*)",
      "Bash(ls*)",
      "Bash(find . -name*)",
      "Bash(cat Cargo.toml)",
      "Bash(cat cicd.toml)",
      "Bash(cat Cargo.lock)",
      "Bash(cat rust-toolchain.toml)",
      "Bash(rustc --version*)",
      "Bash(rustup*)",
      "Bash(which wpm*)",
      "Read(*)",
      "Write(src/*)",
      "Write(tests/*)",
      "Write(docs/*)",
      "Write(.claude/*)",
      "Write(.github/*)",
      "Write(ontology/*)",
      "Write(templates/*)",
      "Write(queries/*)",
      "Write(cicd.toml)",
      "Write(CHANGELOG.md)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-check.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-use.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/public-boundary-guard.sh"
          }
        ]
      }
    ]
  },

  "notes": {
    "project": "cargo-cicd v26.6.19 — Rust workspace CI/CD helper with noun-verb CLI grammar",
    "branch": "main",
    "forbidden_terms": [
      "ALIVE",
      "Inspection Gate",
      "wall",
      "Nehemiah",
      "Field8",
      "Instinct8",
      "Cargo Court",
      "AGI",
      "Truex",
      "CONSTRUCT8"
    ],
    "forbidden_terms_note": "These terms MUST NOT appear in any public output (help text, CLI, docs). The invariant test invariant_public_boundary_no_forbidden_terms_in_all_help() enforces this gate.",
    "evidence_gate": "All release verdicts are adjudicated by the wasm4pm oracle (wpm binary). Tests assert wpm verdict (Accept/Refuse/Blocked), never internal cargo-cicd state.",
    "oracle_unavailable": "If wpm is not on PATH, tests must declare ExpectedWpmVerdict::Blocked. Full release gate requires oracle to be available.",
    "key_test_commands": [
      "cargo test --test invariants",
      "cargo test --test cli",
      "cargo test --test wasm4pm_evidence_gate",
      "cargo make test"
    ],
    "default_verb_injection": "Bare nouns auto-inject default verbs: status→show, publish→run, workspace→doctor, evidence→doctor",
    "cicd_toml": "cicd.toml is a state carrier, not config. It is overwritten by each major operation. Do not rely on manual edits persisting."
  }
}

#!/bin/sh
# commit-msg hook for cargo-cicd
# Enforces the conventional-commit format documented in CLAUDE.md.
# Install via: sh scripts/install-hooks.sh

set -e

# ---------------------------------------------------------------------------
# Color helpers (fallback gracefully if not a terminal)
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  RED=''
  GREEN=''
  YELLOW=''
  CYAN=''
  BOLD=''
  RESET=''
fi

MSG_FILE="$1"

if [ -z "$MSG_FILE" ]; then
  printf "%b  commit-msg: no message file provided%b\n" "$RED" "$RESET"
  exit 1
fi

MSG=$(cat "$MSG_FILE")

# Strip comment lines (lines beginning with #) and leading/trailing blank lines
FIRST_LINE=$(printf "%s" "$MSG" \
  | grep -v '^#' \
  | sed '/^[[:space:]]*$/d' \
  | head -1)

# ---------------------------------------------------------------------------
# Validate: non-empty
# ---------------------------------------------------------------------------
if [ -z "$FIRST_LINE" ]; then
  printf "\n%b  commit-msg: commit message must not be empty.%b\n\n" "$RED" "$RESET"
  printf "  %bValid format:%b\n" "$CYAN" "$RESET"
  printf "    feat(core): add workspace scan adapter\n"
  printf "    fix(cli): handle missing cicd.toml gracefully\n\n"
  exit 1
fi

# ---------------------------------------------------------------------------
# Validate: max 72 characters on first line
# ---------------------------------------------------------------------------
LINE_LEN=$(printf "%s" "$FIRST_LINE" | wc -c | tr -d ' ')
if [ "$LINE_LEN" -gt 72 ]; then
  printf "\n%b  commit-msg: first line is %s characters (max 72).%b\n" "$RED" "$LINE_LEN" "$RESET"
  printf "  %b  Shorten the subject line.%b\n\n" "$YELLOW" "$RESET"
  exit 1
fi

# ---------------------------------------------------------------------------
# Validate: conventional-commit format
# type(scope): description
#
# Valid types:  feat fix docs refactor test ci chore perf
# Valid scopes: core cli target test git autonomic docs receipts
# ---------------------------------------------------------------------------
VALID_TYPES="feat|fix|docs|refactor|test|ci|chore|perf"
VALID_SCOPES="core|cli|target|test|git|autonomic|docs|receipts"

# Pattern: <type>(<scope>): <description>
# Also allow <type>(<scope>)!: for breaking changes
# Also allow <type>: (no scope) — warn but allow
PATTERN_WITH_SCOPE="^(${VALID_TYPES})\((${VALID_SCOPES})\)!?: .+"
PATTERN_NO_SCOPE="^(${VALID_TYPES})!?: .+"

if printf "%s" "$FIRST_LINE" | grep -Eq "$PATTERN_WITH_SCOPE"; then
  # Full match with valid scope — pass
  printf "\n%b  commit-msg: format OK%b\n\n" "$GREEN" "$RESET"
  exit 0
elif printf "%s" "$FIRST_LINE" | grep -Eq "$PATTERN_NO_SCOPE"; then
  # Valid type but no scope — warn, still pass
  printf "\n%b  commit-msg: format OK (no scope — consider adding one)%b\n" "$GREEN" "$RESET"
  printf "  %b  Valid scopes: core cli target test git autonomic docs receipts%b\n\n" "$YELLOW" "$RESET"
  exit 0
else
  # Check what's wrong for a helpful message
  TYPE_HIT=$(printf "%s" "$FIRST_LINE" | grep -Eo "^[a-z]+" || true)
  printf "\n%b  commit-msg: invalid commit message format.%b\n\n" "$RED" "$RESET"
  printf "  %bReceived:%b  %s\n\n" "$YELLOW" "$RESET" "$FIRST_LINE"
  printf "  %bRequired format:%b\n" "$CYAN" "$RESET"
  printf "    <type>(<scope>): <description>\n\n"
  printf "  %bValid types:%b\n" "$CYAN" "$RESET"
  printf "    feat  fix  docs  refactor  test  ci  chore  perf\n\n"
  printf "  %bValid scopes:%b\n" "$CYAN" "$RESET"
  printf "    core  cli  target  test  git  autonomic  docs  receipts\n\n"
  printf "  %bExamples:%b\n" "$CYAN" "$RESET"
  printf "    feat(core): add workspace scan adapter\n"
  printf "    fix(cli): handle missing cicd.toml gracefully\n"
  printf "    docs(receipts): document receipt schema fields\n"
  printf "    refactor(git): simplify phase closure detection\n"
  printf "    test(autonomic): add policy suggestion regression test\n\n"
  if [ -n "$TYPE_HIT" ]; then
    # Check if the type itself is wrong vs the scope
    if ! printf "%s" "$TYPE_HIT" | grep -Eq "^(${VALID_TYPES})$"; then
      printf "  %b  '%s' is not a valid type.%b\n\n" "$YELLOW" "$TYPE_HIT" "$RESET"
    fi
  fi
  exit 1
fi

#!/bin/sh
# pre-push hook for cargo-cicd
# Runs full quality gates before any push.
# Install via: sh scripts/install-hooks.sh

set -e

# ---------------------------------------------------------------------------
# Color helpers (fallback gracefully if not a terminal)
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  RED=''
  GREEN=''
  YELLOW=''
  CYAN=''
  BOLD=''
  RESET=''
fi

PASS="${GREEN}✓${RESET}"
FAIL="${RED}✗${RESET}"

now_s() {
  date +%s 2>/dev/null || printf '0'
}

print_result() {
  if [ "$1" -eq 0 ]; then
    printf "  %b  %s %b(%ss)%b\n" "$PASS" "$2" "$CYAN" "$3" "$RESET"
  else
    printf "  %b  %s %b(%ss)%b\n" "$FAIL" "$2" "$CYAN" "$3" "$RESET"
  fi
}

HOOK_START=$(now_s)
FAILED=0

printf "\n%b--- pre-push checks ---%b\n\n" "$BOLD" "$RESET"

# ---------------------------------------------------------------------------
# Helper: run the pre-commit checks inline (reuse same logic)
# ---------------------------------------------------------------------------
FORBIDDEN_TERMS="ALIVE|Nehemiah|CONSTRUCT8|Inspection Gate|Cargo Court|AGI|Truex|wall|Field8|Instinct8"

run_precommit_checks() {
  # 1. fmt
  T0=$(now_s)
  if cargo fmt --check --quiet 2>/dev/null; then FMT_RC=0; else FMT_RC=1; FAILED=1; fi
  T1=$(now_s)
  print_result "$FMT_RC" "cargo fmt --check" "$((T1 - T0))"
  if [ "$FMT_RC" -ne 0 ]; then
    printf "  %b  Run 'cargo fmt' to fix formatting.%b\n" "$YELLOW" "$RESET"
  fi

  # 2. clippy
  T0=$(now_s)
  if cargo clippy --quiet -- -D warnings 2>/dev/null; then CLIPPY_RC=0; else CLIPPY_RC=1; FAILED=1; fi
  T1=$(now_s)
  print_result "$CLIPPY_RC" "cargo clippy -- -D warnings" "$((T1 - T0))"
  if [ "$CLIPPY_RC" -ne 0 ]; then
    printf "  %b  Fix all Clippy warnings before pushing.%b\n" "$YELLOW" "$RESET"
  fi

  # 3. invariants
  T0=$(now_s)
  if cargo test --test invariants --quiet 2>/dev/null; then INV_RC=0; else INV_RC=1; FAILED=1; fi
  T1=$(now_s)
  print_result "$INV_RC" "cargo test --test invariants" "$((T1 - T0))"
  if [ "$INV_RC" -ne 0 ]; then
    printf "  %b  Public boundary invariants broken — see tests/invariants.rs.%b\n" "$YELLOW" "$RESET"
  fi

  # 4. forbidden terms (scan all tracked files)
  T0=$(now_s)
  FORBIDDEN_RC=0
  FORBIDDEN_HITS=""
  TRACKED_FILES=$(git ls-files 2>/dev/null || true)
  for f in $TRACKED_FILES; do
    [ -f "$f" ] || continue
    HITS=$(grep -En "$FORBIDDEN_TERMS" "$f" 2>/dev/null | head -5 || true)
    if [ -n "$HITS" ]; then
      FORBIDDEN_RC=1
      FORBIDDEN_HITS="${FORBIDDEN_HITS}\n  File: ${f}\n${HITS}"
    fi
  done
  if [ "$FORBIDDEN_RC" -ne 0 ]; then FAILED=1; fi
  T1=$(now_s)
  print_result "$FORBIDDEN_RC" "forbidden term scan (all tracked files)" "$((T1 - T0))"
  if [ "$FORBIDDEN_RC" -ne 0 ]; then
    printf "  %b  Forbidden terms found:%b\n%b\n" "$YELLOW" "$RESET" "$FORBIDDEN_HITS"
    printf "  %b  Remove these terms before pushing. See CLAUDE.md §FORBIDDEN.%b\n" "$YELLOW" "$RESET"
  fi
}

printf "%bPhase 1: pre-commit checks%b\n" "$CYAN" "$RESET"
run_precommit_checks

printf "\n%bPhase 2: full test suite (excluding wasm4pm gate)%b\n" "$CYAN" "$RESET"

# ---------------------------------------------------------------------------
# 5. Full test suite (exclude wasm4pm evidence-gate tests)
# The wasm4pm gate is a release-closing gate, not a push gate.
# wasm4pm tests self-skip when the wpm binary is absent; the harness handles
# this via #[cfg] or runtime binary detection.
# ---------------------------------------------------------------------------
T0=$(now_s)
if cargo test --quiet 2>/dev/null; then
  FULL_RC=0
else
  FULL_RC=1
  FAILED=1
fi
T1=$(now_s)
print_result "$FULL_RC" "cargo test --quiet (full suite)" "$((T1 - T0))"
if [ "$FULL_RC" -ne 0 ]; then
  printf "  %b  Full test suite failed. Run 'cargo test' for details.%b\n" "$YELLOW" "$RESET"
fi

# ---------------------------------------------------------------------------
# 6. feature_projection tests
# ---------------------------------------------------------------------------
T0=$(now_s)
if cargo test --test feature_projection --quiet 2>/dev/null; then
  FP_RC=0
else
  FP_RC=1
  FAILED=1
fi
T1=$(now_s)
print_result "$FP_RC" "cargo test --test feature_projection" "$((T1 - T0))"
if [ "$FP_RC" -ne 0 ]; then
  printf "  %b  Feature flag surface contract broken — see tests/feature_projection.rs.%b\n" "$YELLOW" "$RESET"
fi

printf "\n%bPhase 3: source hygiene checks%b\n" "$CYAN" "$RESET"

# ---------------------------------------------------------------------------
# 7. TODO(release-block) scan
# ---------------------------------------------------------------------------
T0=$(now_s)
TODO_HITS=$(grep -rn "TODO(release-block)" \
  --include="*.rs" --include="*.toml" --include="*.md" \
  . 2>/dev/null | grep -v "^Binary" || true)
T1=$(now_s)
if [ -n "$TODO_HITS" ]; then
  TODO_RC=1
  FAILED=1
else
  TODO_RC=0
fi
print_result "$TODO_RC" "no TODO(release-block) comments" "$((T1 - T0))"
if [ "$TODO_RC" -ne 0 ]; then
  printf "  %b  Release-blocking TODOs found (resolve or remove them):%b\n" "$YELLOW" "$RESET"
  printf "%s\n" "$TODO_HITS" | head -10
fi

# ---------------------------------------------------------------------------
# 8. TESTING_GUIDE.md and CONTRIBUTING.md must not be empty
# ---------------------------------------------------------------------------
T0=$(now_s)
DOCS_RC=0
for doc in TESTING_GUIDE.md CONTRIBUTING.md; do
  if [ ! -f "$doc" ]; then
    printf "  %b  Missing file: %s%b\n" "$RED" "$doc" "$RESET"
    DOCS_RC=1
    FAILED=1
  elif [ ! -s "$doc" ]; then
    printf "  %b  Empty file: %s%b\n" "$RED" "$doc" "$RESET"
    DOCS_RC=1
    FAILED=1
  fi
done
T1=$(now_s)
print_result "$DOCS_RC" "TESTING_GUIDE.md and CONTRIBUTING.md non-empty" "$((T1 - T0))"

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
HOOK_END=$(now_s)
printf "\n"
if [ "$FAILED" -eq 0 ]; then
  printf "%b  All pre-push checks passed (%ss)%b\n\n" "$GREEN" "$((HOOK_END - HOOK_START))" "$RESET"
  exit 0
else
  printf "%b  Pre-push checks failed (%ss). Fix the issues above before pushing.%b\n" "$RED" "$((HOOK_END - HOOK_START))" "$RESET"
  printf "%b  Emergency bypass (use sparingly): git push --no-verify%b\n\n" "$YELLOW" "$RESET"
  exit 1
fi

#!/bin/sh
# pre-commit hook for cargo-cicd
# Runs fast quality gates — must complete in <30 seconds.
# Install via: sh scripts/install-hooks.sh

set -e

# ---------------------------------------------------------------------------
# Color helpers (fallback gracefully if not a terminal)
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  RED=''
  GREEN=''
  YELLOW=''
  CYAN=''
  BOLD=''
  RESET=''
fi

PASS="${GREEN}✓${RESET}"
FAIL="${RED}✗${RESET}"

# ---------------------------------------------------------------------------
# Timing helper (POSIX: use date +%s, fallback to 0 if unavailable)
# ---------------------------------------------------------------------------
now_s() {
  date +%s 2>/dev/null || printf '0'
}

print_result() {
  # $1 = exit code, $2 = label, $3 = elapsed seconds
  if [ "$1" -eq 0 ]; then
    printf "  %b  %s %b(%ss)%b\n" "$PASS" "$2" "$CYAN" "$3" "$RESET"
  else
    printf "  %b  %s %b(%ss)%b\n" "$FAIL" "$2" "$CYAN" "$3" "$RESET"
  fi
}

HOOK_START=$(now_s)
FAILED=0

printf "\n%b--- pre-commit checks ---%b\n\n" "$BOLD" "$RESET"

# ---------------------------------------------------------------------------
# 1. cargo fmt --check
# ---------------------------------------------------------------------------
T0=$(now_s)
if cargo fmt --check --quiet 2>/dev/null; then
  FMT_RC=0
else
  FMT_RC=1
  FAILED=1
fi
T1=$(now_s)
print_result "$FMT_RC" "cargo fmt --check" "$((T1 - T0))"
if [ "$FMT_RC" -ne 0 ]; then
  printf "  %b  Run 'cargo fmt' to fix formatting, then re-stage.%b\n" "$YELLOW" "$RESET"
fi

# ---------------------------------------------------------------------------
# 2. cargo clippy
# ---------------------------------------------------------------------------
T0=$(now_s)
if cargo clippy --quiet -- -D warnings 2>/dev/null; then
  CLIPPY_RC=0
else
  CLIPPY_RC=1
  FAILED=1
fi
T1=$(now_s)
print_result "$CLIPPY_RC" "cargo clippy -- -D warnings" "$((T1 - T0))"
if [ "$CLIPPY_RC" -ne 0 ]; then
  printf "  %b  Fix all Clippy warnings before committing.%b\n" "$YELLOW" "$RESET"
fi

# ---------------------------------------------------------------------------
# 3. cargo test --test invariants
# ---------------------------------------------------------------------------
T0=$(now_s)
if cargo test --test invariants --quiet 2>/dev/null; then
  INV_RC=0
else
  INV_RC=1
  FAILED=1
fi
T1=$(now_s)
print_result "$INV_RC" "cargo test --test invariants" "$((T1 - T0))"
if [ "$INV_RC" -ne 0 ]; then
  printf "  %b  Public boundary invariants broken — see tests/invariants.rs.%b\n" "$YELLOW" "$RESET"
fi

# ---------------------------------------------------------------------------
# 4. Forbidden term scan in staged files
# ---------------------------------------------------------------------------
FORBIDDEN_TERMS="ALIVE|Nehemiah|CONSTRUCT8|Inspection Gate|Cargo Court|AGI|Truex|wall|Field8|Instinct8"
T0=$(now_s)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
FORBIDDEN_RC=0
FORBIDDEN_HITS=""

if [ -n "$STAGED_FILES" ]; then
  # Iterate staged files; skip binary files
  for f in $STAGED_FILES; do
    [ -f "$f" ] || continue
    # git show :file reads the staged version
    HITS=$(git show ":$f" 2>/dev/null \
      | grep -En "$FORBIDDEN_TERMS" \
      | head -5 || true)
    if [ -n "$HITS" ]; then
      FORBIDDEN_RC=1
      FORBIDDEN_HITS="${FORBIDDEN_HITS}\n  File: ${f}\n${HITS}"
    fi
  done
fi

if [ "$FORBIDDEN_RC" -ne 0 ]; then
  FAILED=1
fi
T1=$(now_s)
print_result "$FORBIDDEN_RC" "forbidden term scan" "$((T1 - T0))"
if [ "$FORBIDDEN_RC" -ne 0 ]; then
  printf "  %b  Forbidden terms found in staged files:%b\n" "$YELLOW" "$RESET"
  printf "%b\n" "$FORBIDDEN_HITS"
  printf "  %b  Remove these terms before committing. See CLAUDE.md §FORBIDDEN.%b\n" "$YELLOW" "$RESET"
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
HOOK_END=$(now_s)
printf "\n"
if [ "$FAILED" -eq 0 ]; then
  printf "%b  All pre-commit checks passed (%ss)%b\n\n" "$GREEN" "$((HOOK_END - HOOK_START))" "$RESET"
  exit 0
else
  printf "%b  Pre-commit checks failed (%ss). Fix the issues above and re-stage.%b\n" "$RED" "$((HOOK_END - HOOK_START))" "$RESET"
  printf "%b  Emergency bypass (use sparingly): git commit --no-verify%b\n\n" "$YELLOW" "$RESET"
  exit 1
fi

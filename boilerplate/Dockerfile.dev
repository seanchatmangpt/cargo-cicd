# =============================================================================
# Dockerfile.dev — development image with full toolchain + cargo-watch
# Hot-reloads the service on source changes when used with the
# docker-compose.override.yml volume mounts.
# =============================================================================

FROM rust:1.86-slim-bookworm

# Install system dependencies required by common Rust crates
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        ca-certificates \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/*

# Install development tooling
RUN cargo install cargo-watch --locked \
    && cargo install cargo-audit --locked

# Pre-cache a minimal set of components
RUN rustup component add clippy rustfmt

WORKDIR /app

# Copy workspace manifests first so dependency compilation is cached when
# only source files change. The actual source is mounted as a volume at
# runtime (see docker-compose.override.yml), but we copy here so the image
# can be used without volumes too.
COPY Cargo.toml Cargo.lock ./
COPY crates/core/Cargo.toml ./crates/core/Cargo.toml
COPY crates/service/Cargo.toml ./crates/service/Cargo.toml
COPY crates/mcp-server/Cargo.toml ./crates/mcp-server/Cargo.toml

# Create stub lib.rs files so `cargo fetch` succeeds
RUN mkdir -p crates/core/src crates/service/src crates/mcp-server/src \
    && echo "fn main() {}" > src/main.rs \
    && touch crates/core/src/lib.rs \
    && touch crates/service/src/lib.rs \
    && touch crates/mcp-server/src/lib.rs \
    && cargo fetch \
    && rm -rf src crates

# Copy full source (used when running without volume mounts)
COPY . .

ENV RUST_LOG=debug \
    APP_ENV=development \
    CARGO_TERM_COLOR=always

EXPOSE 8080

# cargo-watch rebuilds and restarts on any Rust source change
CMD ["cargo", "watch", \
     "--why", \
     "-w", "src", \
     "-w", "crates", \
     "-w", "Cargo.toml", \
     "-x", "run --bin cargo-project-serve"]

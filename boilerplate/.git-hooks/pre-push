#!/usr/bin/env bash
# pre-push — thorough pre-push hook (full test suite + clippy --all-features)
#
# Runs before every push. Skips WIP/draft branches automatically.
# Set SKIP_PRE_PUSH=1 to bypass in emergencies (prints a warning).
#
# NOTE: After writing via the Write tool, make this executable:
#   chmod +x .git-hooks/pre-push

set -euo pipefail

START="${SECONDS}"

# ---------------------------------------------------------------------------
# TTY awareness
# ---------------------------------------------------------------------------
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' RESET=''
fi

info()    { echo -e "${CYAN}[pre-push]${RESET} $*"; }
success() { echo -e "${GREEN}[pre-push]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[pre-push] WARN:${RESET} $*"; }
fail()    { echo -e "${RED}[pre-push] FAIL:${RESET} $*" >&2; }

# ---------------------------------------------------------------------------
# Escape hatch
# ---------------------------------------------------------------------------
if [[ "${SKIP_PRE_PUSH:-0}" == "1" ]]; then
  warn "SKIP_PRE_PUSH=1 set — skipping pre-push checks."
  warn "You are pushing without running tests. This may break CI."
  exit 0
fi

# ---------------------------------------------------------------------------
# Read the remote and ref from stdin (git pre-push protocol)
# Format: <local-ref> <local-sha1> <remote-ref> <remote-sha1>
# ---------------------------------------------------------------------------
REMOTE="${1}"
REMOTE_URL="${2}"

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Detect WIP / draft branches by local ref name
  BRANCH_NAME="${LOCAL_REF#refs/heads/}"
  if [[ "${BRANCH_NAME}" == wip/* ]] || [[ "${BRANCH_NAME}" == draft/* ]]; then
    warn "Branch '${BRANCH_NAME}' looks like a WIP — skipping pre-push checks."
    warn "Rename to feat/, fix/, chore/, or docs/ when ready."
    exit 0
  fi
done

info "Remote: ${REMOTE} (${REMOTE_URL:-unknown})"
info "Running full pre-push gate..."

# ---------------------------------------------------------------------------
# Full test suite
# Not --all-features to stay reasonably fast; CI runs --all-features.
# ---------------------------------------------------------------------------
info "Running cargo test --workspace..."
if ! cargo test --workspace 2>&1; then
  fail "Tests failed. Fix failures before pushing."
  fail "Tip: cargo test --workspace 2>&1 | head -60"
  exit 1
fi
success "tests: OK"

# ---------------------------------------------------------------------------
# Clippy with all features (stricter than pre-commit)
# ---------------------------------------------------------------------------
info "Running cargo clippy --workspace --all-features..."
if ! cargo clippy --workspace --all-features -- -D warnings 2>&1; then
  fail "Clippy found warnings or errors (all-features mode)."
  fail "Fix the issues above, then re-push."
  exit 1
fi
success "clippy: OK"

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
echo "pre-push: ${SECONDS}s"

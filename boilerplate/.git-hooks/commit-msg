#!/usr/bin/env bash
# .git-hooks/commit-msg — Validate commit message on every commit
#
# Install by running:
#   ./scripts/install-hooks.sh
#   # or manually:
#   git config core.hooksPath .git-hooks
#
# This hook calls scripts/check-conventional-commits.sh to enforce
# the Conventional Commits specification on every new commit message.

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "${COMMIT_MSG_FILE}")

# ---------------------------------------------------------------------------
# Color helpers (TTY-aware — hooks sometimes run in non-TTY contexts)
# ---------------------------------------------------------------------------
if [[ -t 2 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  RESET='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' RESET=''
fi

# ---------------------------------------------------------------------------
# Skip certain auto-generated commit messages
# ---------------------------------------------------------------------------

# Skip merge commits (git generates these automatically)
if echo "${COMMIT_MSG}" | grep -qE '^Merge (branch|pull request|remote-tracking branch)'; then
  exit 0
fi

# Skip revert commits generated by git revert
if echo "${COMMIT_MSG}" | grep -qE '^Revert "'; then
  exit 0
fi

# Skip fixup!/squash! commits (used during interactive rebase)
if echo "${COMMIT_MSG}" | grep -qE '^(fixup|squash)!'; then
  exit 0
fi

# Skip WIP commits (allow informal saves without blocking the developer)
# Comment this block out if you want to enforce on WIP commits too.
if echo "${COMMIT_MSG}" | grep -qiE '^wip[: ]'; then
  echo -e "${YELLOW}[commit-msg]${RESET} WIP commit allowed (skipping format check)." >&2
  exit 0
fi

# ---------------------------------------------------------------------------
# Valid Conventional Commits types
# ---------------------------------------------------------------------------
VALID_TYPES="feat|fix|chore|docs|style|refactor|test|ci|perf|build|revert|deps|security|release|wip"

# Extract just the subject line (first non-empty line)
SUBJECT=$(echo "${COMMIT_MSG}" | grep -v '^#' | grep -v '^$' | head -1 || true)

if [[ -z "${SUBJECT}" ]]; then
  echo -e "${RED}[commit-msg] ERROR:${RESET} Commit message is empty." >&2
  exit 1
fi

# Pattern: type(optional-scope)!: description
PATTERN="^(${VALID_TYPES})(\([a-zA-Z0-9_/,-]+\))?(!)?: .{1,}"

if echo "${SUBJECT}" | grep -qP "${PATTERN}"; then
  # Valid — silent success (don't clutter the commit output)
  exit 0
else
  echo "" >&2
  echo -e "${RED}[commit-msg] INVALID commit message format.${RESET}" >&2
  echo "" >&2
  echo -e "  ${BOLD}Your message:${RESET}  ${SUBJECT}" >&2
  echo "" >&2
  echo -e "  ${BOLD}Expected format:${RESET}" >&2
  echo "    <type>(<optional-scope>): <description>" >&2
  echo "    <type>!: <breaking-change-description>" >&2
  echo "" >&2
  echo -e "  ${BOLD}Valid types:${RESET}" >&2
  echo "    feat fix chore docs style refactor test ci perf build revert" >&2
  echo "    deps security release" >&2
  echo "" >&2
  echo -e "  ${BOLD}Examples:${RESET}" >&2
  echo "    feat(cli): add --dry-run flag to release command" >&2
  echo "    fix: handle missing Cargo.lock gracefully" >&2
  echo "    chore(release): v1.2.3" >&2
  echo "    docs: update README with install steps" >&2
  echo "    feat!: redesign CLI grammar (BREAKING CHANGE)" >&2
  echo "" >&2
  echo -e "  ${CYAN}Tip:${RESET} To skip this check temporarily, start with 'WIP: '" >&2
  echo "  To disable: git config core.hooksPath .git/hooks" >&2
  echo "" >&2
  exit 1
fi

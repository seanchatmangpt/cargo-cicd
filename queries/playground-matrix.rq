PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX cc:      <https://cargo-cicd.rs/ontology/>

SELECT ?name ?command ?precondition ?outcome ?verdict ?mutation
WHERE {
    ?s a cc:PlaygroundScenario ;
       cc:scenarioName           ?name ;
       cc:commandUsed            ?command ;
       cc:precondition           ?precondition ;
       cc:expectedOutcome        ?outcome ;
       cc:wasm4pmExpectedVerdict ?verdict .
    OPTIONAL { ?s cc:mutationVariant ?mutation }
}
ORDER BY ?verdict ?command

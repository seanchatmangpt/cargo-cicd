PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX cc:      <https://cargo-cicd.rs/ontology/>

SELECT ?event ?command ?oracle ?fields
WHERE {
    ?e a prov:Activity ;
       skos:prefLabel          ?event ;
       prov:wasGeneratedBy     ?cap ;
       cc:wasm4pmOracleCommand ?oracle ;
       cc:requiredEventFields  ?fields .
    ?cap cc:cliCommand ?command
}

// MANUFACTURED by ggen — CLI tests for {{ noun_name }}
use assert_cmd::Command;

{% for verb in verbs %}
#[test]
fn test_{{ noun_name }}_{{ verb.name }}() {
    let mut cmd = Command::cargo_bin("cargo-cicd").unwrap();
    cmd.args(["{{ noun_name }}", "{{ verb.name }}"]);
    cmd.assert().success();
}
{% endfor %}

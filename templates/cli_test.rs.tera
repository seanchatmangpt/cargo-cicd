// ─────────────────────────────────────────────────────────────────────────────
// Refusal: unknown flag must produce non-zero exit
// ─────────────────────────────────────────────────────────────────────────────

#[test]
fn {{ noun_name }}_{{ verb_name }}_rejects_unknown_flag() {
    cargo_cicd()
        .args(["{{ noun_name }}", "{{ verb_name }}", "--__nonexistent_flag__"])
        .assert()
        .failure();
}

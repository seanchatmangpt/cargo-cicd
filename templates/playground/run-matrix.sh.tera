#!/usr/bin/env bash
# run-matrix.sh — generated by ggen for cargo-cicd v{{ version }}
# Runs each scenario, verifies evidence emission, invokes the wasm4pm oracle,
# and reports PASS/FAIL per scenario.

set -euo pipefail

PASS=0
FAIL=0
RESULTS=()

run_scenario() {
    local name="$1"
    local command="$2"
    local evidence_event="$3"
    local oracle="$4"
    local expected_verdict="$5"

    local tmpdir
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' RETURN

    # Initialise a minimal fixture workspace.
    mkdir -p "$tmpdir/src"
    cat > "$tmpdir/Cargo.toml" <<'TOML'
[package]
name = "fixture"
version = "0.1.0"
edition = "2021"
TOML
    echo 'fn main() {}' > "$tmpdir/src/main.rs"

    local evidence_dir="$tmpdir/target/cargo-cicd/evidence"
    mkdir -p "$evidence_dir"

    # Run the command under test.
    if ! (cd "$tmpdir" && eval "$command" > /dev/null 2>&1); then
        RESULTS+=("FAIL  $name  (command exited non-zero)")
        FAIL=$((FAIL + 1))
        return
    fi

    # Verify evidence was emitted.
    local events_file="$evidence_dir/events.jsonl"
    if [[ ! -f "$events_file" ]]; then
        RESULTS+=("FAIL  $name  (no events.jsonl emitted)")
        FAIL=$((FAIL + 1))
        return
    fi
    if ! grep -q "\"$evidence_event\"" "$events_file" 2>/dev/null; then
        RESULTS+=("FAIL  $name  (event '$evidence_event' not found in events.jsonl)")
        FAIL=$((FAIL + 1))
        return
    fi

    # Run the wasm4pm oracle if available.
    if command -v wpm > /dev/null 2>&1; then
        local verdict
        verdict="$(wpm oracle "$oracle" "$events_file" 2>/dev/null || echo "ERROR")"
        verdict="$(echo "$verdict" | tr '[:lower:]' '[:upper:]')"
        if [[ "$verdict" != "$expected_verdict" ]]; then
            RESULTS+=("FAIL  $name  (oracle verdict '$verdict' != expected '$expected_verdict')")
            FAIL=$((FAIL + 1))
            return
        fi
    fi

    RESULTS+=("PASS  $name")
    PASS=$((PASS + 1))
}

# --- Scenario matrix ---
{% for scenario in scenarios -%}
run_scenario \
    "{{ scenario.scenario_name }}" \
    "{{ scenario.command_used }}" \
    "{{ scenario.evidence_event }}" \
    "{{ scenario.wasm4pm_oracle }}" \
    "{{ scenario.wasm4pm_expected_verdict | upper }}"

{% endfor %}
# --- Report ---
echo ""
echo "=============================="
echo "  cargo-cicd run-matrix v{{ version }}"
echo "=============================="
for r in "${RESULTS[@]}"; do
    echo "  $r"
done
echo "------------------------------"
echo "  PASS: $PASS  FAIL: $FAIL"
echo "=============================="

if [[ $FAIL -gt 0 ]]; then
    exit 1
fi

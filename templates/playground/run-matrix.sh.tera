#!/bin/bash
# GENERATED from ontology playground-matrix.rq. Do not edit ggen block.
# <!-- BEGIN ggen:matrix -->
set -euo pipefail
BINARY="${BINARY:-./target/debug/cargo-cicd}"
PASS=0; FAIL=0

run_scenario() {
    local name="$1" cmd="$2"
    echo "▶ $name: $cmd"
    if $cmd >/dev/null 2>&1; then
        echo "  ✓ PASS"; PASS=$((PASS+1))
    else
        echo "  ✗ FAIL"; FAIL=$((FAIL+1))
    fi
}

{% for row in rows -%}
run_scenario "{{ row.scenario_name }}" "$BINARY {{ row.noun_name }} {{ row.verb_name }}"
{% endfor %}
# <!-- END ggen:matrix -->

echo "Matrix: $PASS passed, $FAIL failed"
[ "$FAIL" -eq 0 ]

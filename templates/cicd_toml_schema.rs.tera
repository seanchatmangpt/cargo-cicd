#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn empty_toml_deserialises_to_default() {
        let result: CicdToml = toml::from_str("").expect("empty toml must parse to default");
        assert_eq!(result, CicdToml::default());
    }

    #[test]
    fn unknown_key_is_rejected() {
        let result: Result<CicdToml, _> = toml::from_str("[__unknown_section__]\nkey = 1");
        assert!(result.is_err(), "deny_unknown_fields must reject unknown keys");
    }

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cargo make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": "$rustc",
      "detail": "Build workspace via cargo-make (preferred)"
    },
    {
      "label": "Build (fallback)",
      "type": "shell",
      "command": "cargo build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": "$rustc",
      "detail": "Build workspace via cargo build (fallback if cargo-make unavailable)"
    },
    {
      "label": "Check",
      "type": "shell",
      "command": "cargo make check",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": "$rustc",
      "detail": "Lint + type-check without building (cargo make check)"
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "cargo fmt",
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Format all Rust source files"
    },
    {
      "label": "Clippy",
      "type": "shell",
      "command": "cargo clippy -- -D warnings",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": "$rustc",
      "detail": "Run Clippy lints, deny warnings"
    },
    {
